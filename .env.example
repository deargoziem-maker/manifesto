# Copy this file to .env.local for local testing with `vercel dev` (never commit .env.local).
# In production, set these under the Vercel project's Settings -> Environment Variables instead —
# never in frontend code. Only api/*.js (server-side) ever reads these.

# Supabase project settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public completion counter (see api/counter.js). Leave unset/false until
# there's a number worth showing; flip to "true" in Vercel env vars later,
# no code change or redeploy needed to toggle it.
COUNTER_ENABLED=false

# Phase 2: bearer token the admin dashboard's /api/admin/* endpoints check for.
# Generate any long random string, e.g. `openssl rand -hex 32`.
ADMIN_TOKEN=
